                "v": "[{\"name\":\"temp_mixer\",\"addr\":\"DB11,REAL0\"},{\"name\":\"speed_mixer\",\"addr\":\"DB11,INT4\"},{\"name\":\"time_mixing\",\"addr\":\"DB11,INT6\"}]",
                "vt": "json"
            }
        ],
        "repeat": "",
