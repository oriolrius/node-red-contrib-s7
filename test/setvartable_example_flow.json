[
    {
        "id": "example_flow_tab",
        "type": "tab",
        "label": "S7 SetVarTable Example",
        "disabled": false,
        "info": "Demonstrates dynamic variable table management using the setvartable function"
    },
    {
        "id": "s7_endpoint_example",
        "type": "s7 endpoint",
        "name": "Example PLC",
        "transport": "iso-on-tcp",
        "address": "192.168.1.100",
        "port": "102",
        "rack": "0",
        "slot": "1",
        "cycletime": "1000",
        "timeout": "2000",
        "vartable": [
            {
                "name": "initial_temp",
                "addr": "DB1,REAL0"
            },
            {
                "name": "initial_pressure",
                "addr": "DB1,REAL4"
            }
        ]
    },
    {
        "id": "inject_recipe_chocolate",
        "type": "inject",
        "z": "example_flow_tab",
        "name": "Switch to Chocolate Recipe",
        "props": [
            {
                "p": "function",
                "v": "setvartable",
                "vt": "str"
            },
            {
                "p": "vartable",
                "v": "[{\"name\":\"temp_mixer\",\"addr\":\"DB10,REAL0\"},{\"name\":\"speed_mixer\",\"addr\":\"DB10,INT4\"},{\"name\":\"time_mixing\",\"addr\":\"DB10,INT6\"}]",
                "vt": "json"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "x": 200,
        "y": 100,
        "wires": [
            [
                "s7_control_node"
            ]
        ]
    },
    {
        "id": "inject_recipe_vanilla",
        "type": "inject",
