    {
        "id": "function_dynamic_vars",
        "type": "function",
        "z": "example_flow_tab",
        "name": "Dynamic Variable Selection",
        "func": "// Dynamic variable table based on time or condition\nvar hour = new Date().getHours();\nvar variables;\n\nif (hour >= 8 && hour < 16) {\n    // Day shift variables\n    variables = [\n        {\"name\": \"day_temp\", \"addr\": \"DB1,REAL0\"},\n        {\"name\": \"day_pressure\", \"addr\": \"DB1,REAL4\"},\n        {\"name\": \"operator_count\", \"addr\": \"DB1,INT8\"}\n    ];\n} else {\n    // Night shift variables\n    variables = [\n        {\"name\": \"night_temp\", \"addr\": \"DB2,REAL0\"},\n        {\"name\": \"night_pressure\", \"addr\": \"DB2,REAL4\"},\n        {\"name\": \"security_mode\", \"addr\": \"DB2,X8.0\"}\n    ];\n}\n\nmsg.function = \"setvartable\";\nmsg.vartable = variables;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 200,
        "y": 220,
        "wires": [
            [
                "s7_control_node"
            ]
        ]
    },
    {
        "id": "inject_time_based",
        "type": "inject",
        "z": "example_flow_tab",
        "name": "Time-Based Variables",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "{}",
        "payloadType": "json",
        "x": 200,
        "y": 260,
        "wires": [
            [
                "function_dynamic_vars"
            ]
        ]
    }
]
