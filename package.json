{
    "name": "@oriolrius/node-red-contrib-s7",
    "version": "4.4.0",
    "description": "A Node-RED node to interact with Siemens S7 PLCs",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oriolrius/node-red-contrib-s7.git"
    },
    "bugs": {
        "url": "https://github.com/oriolrius/node-red-contrib-s7/issues"
    },
    "scripts": {
        "test": "node tests/vartable.test.js",
        "test:e2e": "node tests/e2e/setvartable.e2e.js",
        "release": "./scripts/release.sh",
        "release:patch": "./scripts/release.sh patch",
        "release:minor": "./scripts/release.sh minor",
        "release:major": "./scripts/release.sh major",
        "version:check": "npm version --dry-run"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org"
    },
    "keywords": [
        "hardware",
        "s7",
        "logo",
        "siemens",
        "plc",
        "profinet",
        "node-red"
    ],
    "node-red": {
        "version": ">=3.0.0",
        "nodes": {
            "s7": "red/s7.js"
        }
    },
    "author": "Oriol Rius",
    "license": "GPL-3.0-or-later",
    "dependencies": {
        "@oriolrius/nodes7": "^1.1.3"
    }
}
